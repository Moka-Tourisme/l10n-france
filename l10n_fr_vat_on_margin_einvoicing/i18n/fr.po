#. module: l10n_fr_vat_on_margin_einvoicing
#: model:ir.model,name:l10n_fr_vat_on_margin_einvoicing.model_account_tax
msgid "Tax"
msgstr "Taxe"

#. module: l10n_fr_vat_on_margin_einvoicing
#. odoo-python
#: code:addons/l10n_fr_vat_on_margin_einvoicing/models/account_tax.py:0
#, python-format
msgid ""
"Tax '%(tax)s' must have both the 'VAT on Margin' option and the 'Margin "
"Percentage' computation, or neither."
msgstr ""
"La taxe '%(tax)s' doit avoir à la fois l'option 'TVA sur marge' et le calcul "
"'Pourcentage de la marge', ou aucun des deux."

#. module: l10n_fr_vat_on_margin_einvoicing
#. odoo-python
#: code:addons/l10n_fr_vat_on_margin_einvoicing/models/account_tax.py:0
#, python-format
msgid ""
"VAT on margin tax '%(tax)s' must have the UNECE Tax Category 'E' and the VAT"
" Exemption Reason of its margin scheme: %(reasons)s."
msgstr ""
"La taxe de TVA sur marge '%(tax)s' doit avoir la catégorie UNECE 'E' et le "
"motif d'exonération de TVA de son régime de marge : %(reasons)s."
